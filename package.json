{
  "name": "heroes-messupeli",
  "version": "1.0.0",
  "private": true,
  "description": "HEROES-allianssin messupeli: 2D-sivuttaisvierivä automaattijuoksija selaimessa.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "release": "npm run build && node tools/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-map.mjs && node tools/generate-sprites.mjs"
  },
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^5.0.1",
    "world-atlas": "^2.0.2"
  }
}
